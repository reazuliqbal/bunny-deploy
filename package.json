{
  "name": "bunny-deploy",
  "version": "0.1.0",
  "description": "Deploy your static website to Bunny.net straight from Github",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/glob": "^0.7.0",
    "@bunny.net/storage-sdk": "^0.3.1",
    "p-queue": "^9.3.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "inlinedDependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/glob": "0.7.0",
    "@actions/http-client": "4.0.1",
    "@actions/io": "3.0.2",
    "@bunny.net/storage-sdk": "0.3.1",
    "balanced-match": "4.0.4",
    "brace-expansion": "5.0.9",
    "eventemitter3": "5.0.4",
    "minimatch": "10.2.6",
    "p-queue": "9.3.3",
    "p-timeout": "7.0.1",
    "tunnel": "0.0.6",
    "undici": "6.28.0",
    "zod": "3.25.76"
  }
}
